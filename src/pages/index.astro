---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadSite } from "../data/loadSite";
import Sidebar from "../components/Sidebar.astro";
import Section from "../components/Section.astro";
import Experience from "../components/Experience.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";

const data = loadSite();
const nav = [
  { id: "experience", label: "Experience" },
  { id: "research", label: "Research & publications" },
  { id: "projects", label: "Projects" },
  { id: "skills", label: "Skills & education" },
  { id: "contact", label: "Contact" },
];
const year = new Date().getFullYear();
const areas = [...new Set(data.projects.map((p) => p.area).filter(Boolean))].map((name) => ({
  name: name as string,
  count: data.projects.filter((p) => p.area === name).length,
}));
---

<BaseLayout
  title={`${data.name} · AI Engineer`}
  description={`${data.name}: AI engineer in Baku. CS at ADA University (Dec 2026), AI engineering intern at HAL-X, co-founder of QuickRecap. Projects in ML, NLP and deepfake detection.`}
  person={{
    name: data.name,
    jobTitle: "AI Engineer Intern",
    email: data.contact.email,
    sameAs: [data.contact.github, data.contact.linkedin],
    image: "profile.png",
  }}
>
  <div class="backdrop" aria-hidden="true"></div>
  <a class="skip" href="#content">Skip to content</a>

  <div class="mbar">
    <a class="mbar-name" href="#top">{data.name}</a>
    <div class="mbar-actions">
      <a class="btn btn-primary btn-sm" href={`mailto:${data.contact.email}`}>
        <Icon name="mail" size={15} /> Get in touch
      </a>
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <span class="i-sun"><Icon name="sun" /></span><span class="i-moon"><Icon name="moon" /></span>
      </button>
    </div>
  </div>

  <div class="shell" id="top">
    <Sidebar data={data} nav={nav} />

    <main id="content">
      <Section id="experience" num="01" title="Experience">
        <Experience items={data.experience} />
      </Section>

      <Section id="research" num="02" title="Research & publications">
        {
          data.publications.map((pub) => (
            <article class="card pub reveal">
              <div class="card-head">
                <span class="chip chip-accent">{pub.venue}</span>
                <span class="card-date">{pub.date}</span>
              </div>
              <h3 class="card-title">{pub.title}</h3>
              <p class="card-lede">{pub.status}</p>
              <p class="card-context">{pub.authors}</p>
            </article>
          ))
        }
      </Section>

      <Section id="projects" num="03" title="Academic & personal projects">
        <div class="featured">
          {data.featured.map((p) => <ProjectCard project={p} featured />)}
        </div>
        <details class="more-projects" data-deck>
          <summary class="deck">
            <span class="deck-stack" aria-hidden="true">
              {data.projects.slice(0, 3).map((p, i) => (
                <span class="deck-card" style={`--d:${i}`}>
                  <span class="deck-card-title">{p.name}</span>
                  {p.metric && <span class="deck-card-metric">{p.metric}</span>}
                </span>
              ))}
            </span>
            <span class="deck-label">
              <span class="deck-icon" aria-hidden="true"><Icon name="stack" size={18} /></span>
              <span class="more-open">Explore {data.projects.length} more projects</span>
              <span class="more-close">Show fewer projects</span>
              <span class="deck-areas">{areas.map((a) => a.name).join(" · ")}</span>
            </span>
          </summary>
          <div class="deck-filters" role="group" aria-label="Filter projects">
            <button type="button" class="filter" data-filter="all" aria-pressed="true">All <span>{data.projects.length}</span></button>
            {areas.map((a) => (
              <button type="button" class="filter" data-filter={a.name} aria-pressed="false">{a.name} <span>{a.count}</span></button>
            ))}
          </div>
          <div class="grid deck-grid">
            {data.projects.map((p, i) => <ProjectCard project={p} index={i} reveal={false} />)}
          </div>
        </details>
      </Section>

      <Section id="skills" num="04" title="Skills & education">
        <dl class="skills reveal">
          {
            data.skills.map((s) => (
              <div class="skill-row">
                <dt>{s.group}</dt>
                <dd>
                  <ul class="tags">
                    {s.items.map((i) => (
                      <li>{i}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
          <div class="skill-row">
            <dt>Languages</dt>
            <dd class="langs">
              {data.languages.map((l) => <span>{l.name} <span class="muted">({l.level})</span></span>)}
            </dd>
          </div>
        </dl>


        <ul class="edu reveal">
          {
            data.education.map((e) => (
              <li class="edu-row">
                <span><strong>{e.institution}</strong> <span class="muted">· {e.degree}</span></span>
                <span class="card-date">{e.date}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <footer class="footer reveal" id="contact" aria-labelledby="contact-title">
        <h2 class="sr-only" id="contact-title">Contact</h2>
        <div class="footer-main">
          <div class="footer-cta">
            <a class="btn btn-primary btn-lg" href={`mailto:${data.contact.email}`}><Icon name="mail" size={18} /> Get in touch</a>
            <a class="copy-email" href={`mailto:${data.contact.email}`} data-copy={data.contact.email} aria-label={`Copy email address ${data.contact.email}`}>
              <span class="copy-text">{data.contact.email}</span>
              <span class="copy-icon" aria-hidden="true"><span class="i-copy"><Icon name="copy" size={15} /></span><span class="i-check"><Icon name="check" size={15} /></span></span>
            </a>
          </div>
          <div class="footer-social">
            <a class="icon-btn" href={data.contact.github} aria-label="GitHub" rel="me"><Icon name="github" /></a>
            <a class="icon-btn" href={data.contact.linkedin} aria-label="LinkedIn" rel="me"><Icon name="linkedin" /></a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} {data.name}</span>
          <a href="#top" class="to-top">Back to top <Icon name="arrow" size={13} /></a>
        </div>
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </footer>
    </main>
  </div>
</BaseLayout>
