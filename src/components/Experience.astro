---
import type { Experience } from "../types/site";
import Icon from "./Icon.astro";

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
---

<ol class="timeline">
  {
    items.map((job) => (
      <li class="job reveal">
        <p class="job-date">
          {job.start} – {job.end}
        </p>
        <div class="job-body">
          <h3 class="job-title">
            {job.title} <span class="at">·</span> <span class="company">{job.company}</span>
          </h3>
          <p class="job-meta">
            {job.location}
            {job.metric && <span class="chip chip-accent">{job.metric}</span>}
            {job.url && (
              <a class="inline-link" href={job.url}>
                {job.url_label ?? "Link"} <Icon name="arrow" size={14} />
              </a>
            )}
          </p>
          <ul class="bullets">
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <ul class="tags" aria-label="Tools">
            {job.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          {job.note && (
            <p class="fine">
              <Icon name="lock" size={13} /> {job.note}
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>
