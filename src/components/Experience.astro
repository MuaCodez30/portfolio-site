---
import type { Experience } from "../types/site";
import Icon from "./Icon.astro";

interface Props {
  items: Experience[];
}
const { items } = Astro.props;
// Split a quote around its key phrase so that phrase can be highlighted
const parts = (text: string, hl?: string) => {
  const i = hl ? text.indexOf(hl) : -1;
  return i < 0 ? [text, "", ""] : [text.slice(0, i), hl as string, text.slice(i + (hl as string).length)];
};
const initials = (name: string) => name.split(" ").map((w) => w[0]).join("").slice(0, 2);
---

<ol class="jobs">
  {
    items.map((job) => (
      <li class:list={["card", "job-card", "reveal", { "has-more": job.bullets?.length }]}>
        <div class="job-head">
          <h3 class="job-title">
            {job.title} <span class="at">·</span> <span class="company">{job.company}</span>
          </h3>
          <p class="job-date">
            {job.start} – {job.end}
          </p>
        </div>
        {(job.location || job.metric || job.url || job.website) && (
          <p class="job-meta">
            {job.location}
            {job.metric && <span class="chip chip-accent">{job.metric}</span>}
            {job.url && (
              <a class="inline-link" href={job.url}>
                {job.url_label ?? "Link"} <Icon name="arrow" size={14} />
              </a>
            )}
            {job.website && (
              <a class="inline-link" href={job.website}>
                Website <Icon name="arrow" size={14} />
              </a>
            )}
          </p>
        )}
        <p class="job-summary">{job.summary}</p>
        <ul class="tags" aria-label="Tools">
          {job.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
        {job.quote && (
          <figure class="quote">
            <span class="quote-mark" aria-hidden="true">“</span>
            <blockquote>
              <p>{parts(job.quote.text, job.quote.highlight)[0]}{job.quote.highlight && <mark>{parts(job.quote.text, job.quote.highlight)[1]}</mark>}{parts(job.quote.text, job.quote.highlight)[2]}</p>
            </blockquote>
            <figcaption>
              <span class="quote-avatar" aria-hidden="true">{initials(job.quote.author)}</span>
              <span class="quote-who">
                <strong>{job.quote.author}</strong>
                <span>{job.quote.role}{job.quote.relation && <> · {job.quote.relation}</>}</span>
              </span>
              {job.quote.url && (
                <a class="quote-source" href={job.quote.url}>
                  <Icon name="linkedin" size={13} /> Verified on LinkedIn <Icon name="arrow" size={12} />
                </a>
              )}
            </figcaption>
          </figure>
        )}
        {job.bullets?.length ? (
          <details class="more">
            <summary>
              <span class="more-open">Learn more</span>
              <span class="more-close">Show less</span>
              <Icon name="arrow" size={14} />
            </summary>
            <ul class="bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            {job.note && (
              <p class="fine">
                <Icon name="lock" size={13} /> {job.note}
              </p>
            )}
          </details>
        ) : null}
      </li>
    ))
  }
</ol>
