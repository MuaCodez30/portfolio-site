---
import type { Project } from "../types/site";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  featured?: boolean;
  index?: number;
  reveal?: boolean;
}
const { project: p, featured = false, index = 0, reveal = true } = Astro.props;
---

<article class:list={["card", { reveal, "card-featured": featured }]} data-area={p.area} style={`--i:${index}`}>
  <div class="card-head">
    {p.metric && <span class="chip chip-accent">{p.metric}</span>}
    <span class="card-date">{p.date}</span>
  </div>
  <h3 class="card-title">{p.name}</h3>
  {p.context && <p class="card-context">{p.context}</p>}
  <p class="card-lede">{p.lede}</p>
  {
    p.bullets && (
      <ul class="bullets">
        {p.bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )
  }
  <ul class="tags" aria-label="Tools">
    {p.tags.map((t) => (
      <li>{t}</li>
    ))}
  </ul>
  {
    (p.repo || p.demo || p.note) && (
      <p class="card-links">
        {p.repo && (
          <a class="inline-link" href={p.repo}>
            <Icon name="github" size={14} /> Code <Icon name="arrow" size={13} />
          </a>
        )}
        {p.demo && (
          <a class="inline-link" href={p.demo}>
            Demo <Icon name="arrow" size={13} />
          </a>
        )}
        {p.note && (
          <span class="fine">
            <Icon name="lock" size={13} /> {p.note}
          </span>
        )}
      </p>
    )
  }
</article>
