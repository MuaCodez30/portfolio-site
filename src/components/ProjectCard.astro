---
import type { Project } from "../types/site";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  featured?: boolean;
}
const { project: p, featured = false } = Astro.props;
---

<article class:list={["card", "reveal", { "card-featured": featured, "has-more": featured && p.bullets?.length }]}>
  <div class="card-head">
    {p.metric && <span class="chip chip-accent">{p.metric}</span>}
    <span class="card-date">{p.date}</span>
  </div>
  <h3 class="card-title">{p.name}</h3>
  {p.context && <p class="card-context">{p.context}</p>}
  <p class="card-lede">{p.lede}</p>
  <ul class="tags" aria-label="Tools">
    {p.tags.map((t) => (
      <li>{t}</li>
    ))}
  </ul>
  {
    (p.repo || p.demo || p.note) && (
      <p class="card-links">
        {p.repo && (
          <a class="inline-link" href={p.repo}>
            <Icon name="github" size={14} /> Code <Icon name="arrow" size={13} />
          </a>
        )}
        {p.demo && (
          <a class="inline-link" href={p.demo}>
            Demo <Icon name="arrow" size={13} />
          </a>
        )}
        {p.note && (
          <span class="fine">
            <Icon name="lock" size={13} /> {p.note}
          </span>
        )}
      </p>
    )
  }
  {
    p.bullets?.length ? (
      <details class="more">
        <summary>
          <span class="more-open">Learn more</span>
          <span class="more-close">Show less</span>
          <Icon name="arrow" size={14} />
        </summary>
        <ul class="bullets">
          {p.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </details>
    ) : null
  }
</article>
