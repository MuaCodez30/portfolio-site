---
import type { SiteData } from "../types/site";
import Icon from "./Icon.astro";

interface Props {
  data: SiteData;
  nav: { id: string; label: string }[];
}
const { data, nav } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header class="side">
  <div class="side-top">
    <span class="avatar intro" style="--i:0" data-avatar>
      <img
        src={`${base}profile.png`}
        alt={`Portrait of ${data.name}`}
        width="200"
        height="200"
        fetchpriority="high"
      />
    </span>
    <h1 class="name intro" style="--i:1">{data.name}</h1>
    <p class="role intro" style="--i:2">{data.role}</p>
    <p class="lede intro" style="--i:3">{data.lede}</p>
    <p class="status intro" style="--i:4">
      <span class="dot" aria-hidden="true"></span>{data.status}
    </p>

    <div class="side-actions intro" style="--i:5">
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={`mailto:${data.contact.email}`}>
          <Icon name="mail" size={18} /> Get in touch
        </a>
        <a class="btn btn-lg" href={`${base}resume.pdf`} download="Muaataz-Ismaeel-CV.pdf">
          <Icon name="download" size={17} /> Download CV
        </a>
      </div>
    </div>

    <nav class="side-nav" aria-label="Sections" data-nav>
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={`#${n.id}`}>
                <span class="nav-line" aria-hidden="true" />
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
